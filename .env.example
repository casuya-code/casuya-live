# --- data-ingestion-go ---
REDIS_URL=redis://default:password@localhost:6379/0
PROVIDER_WS_URL=wss://provider.example.com/live
MARKETS_SCOPE=1H_1X2,2H_1X2,CS_1H,CS_2H

# --- analytics-engine-py ---
ANALYTICS_IN_CHANNEL=matches:live
EXECUTION_OUT_CHANNEL=execution:commands
DIAGNOSTICS_CHANNEL=diagnostics:events
EXECUTION_SERVICE_URL=http://localhost:8080
INTERNAL_AUTH_SECRET=change-me-in-production
MIN_TRIGGER_ODDS=5.0
TRUE_PROB_MARGIN_SLACK=0.02
STAKE_AMOUNT=25.0

# --- execution-engine-go ---
BOOKMAKER_API_KEY=change-me
BOOKMAKER_WS_URL=wss://bookmaker.example.com/trade
LISTEN_ADDR=:8080

# --- web-interface-js/frontend ---
# The relay serves WebSocket upgrades on /ws; the path is appended
# automatically if omitted, but being explicit is preferred.
NEXT_PUBLIC_WS_BACKEND_URL=wss://api-casuya-live.up.railway.app/ws