# --- data-ingestion-go ---
REDIS_URL=redis://localhost:6379/0
# Local (mock vendor on ws://, NOT the production wss://):
PROVIDER_WS_URL=ws://localhost:19999/vendor
# Production:
# PROVIDER_WS_URL=wss://provider.example.com/live
MARKETS_SCOPE=1H_1X2,2H_1X2,CS_1H,CS_2H

# --- analytics-engine-py ---
ANALYTICS_IN_CHANNEL=matches:live
EXECUTION_OUT_CHANNEL=execution:commands
DIAGNOSTICS_CHANNEL=diagnostics:events
# Requests the execution engine, which listens on 8081 locally:
EXECUTION_SERVICE_URL=http://localhost:8081
INTERNAL_AUTH_SECRET=local-dev-secret
MIN_TRIGGER_ODDS=5.0
TRUE_PROB_MARGIN_SLACK=0.02
STAKE_AMOUNT=25.0

# --- mock-vendor ---
# Built-in simulator: vendor feed + bookmaker, no external credentials.
MOCK_VENDOR_PORT=19999
MOCK_TRADE_PORT=19998
REDIS_URL=redis://localhost:6379/0      # settlement bus (bookmaker:settlements)
SETTLE_CHANNEL=bookmaker:settlements

# --- execution-engine-go ---
BOOKMAKER_API_KEY=local-test-key
# Local mock bookmaker:
BOOKMAKER_WS_URL=ws://localhost:19998/trade
# Production:
# BOOKMAKER_WS_URL=wss://bookmaker.example.com/trade
LISTEN_ADDR=:8081
# PnL feedback: reads graded results, publishes snapshots + accumulates pnl:session
SETTLE_IN_CHANNEL=bookmaker:settlements
PNL_OUT_CHANNEL=execution:pnl
PNL_HASH=pnl:session

# --- web-interface-js/frontend ---
# The relay serves WebSocket upgrades on /ws.
NEXT_PUBLIC_WS_BACKEND_URL=ws://localhost:8080/ws

# --- web-interface-js/backend (relay) ---
# Pre-shared secret for the admin tier. Public WebSocket clients only see the
# live match feed; /api/stats and admin channels (pnl, diagnostics,
# execution:commands) require a session token issued from /api/auth/token
# using this secret. Set once into the relay process env.
ADMIN_SECRET=local-admin-secret